APP_NAME="Fuel Prices PK"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8010
API_URL="${APP_URL}/api/v1"
APP_TIMEZONE=Asia/Karachi
SUPPORT_EMAIL=support@topgradesoftware.com
# Production: FORCE_HTTPS=true and APP_URL=https://oilprice.topgradesoftware.com
FORCE_HTTPS=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Production: mysql + topgrade_oilprice. Local: sqlite is fine.
DB_CONNECTION=sqlite

# World catalog (nnjeim/world) uses prefixed tables: world_countries, world_cities, …
# Seed: php artisan db:seed --class=WorldSeeder
#        php artisan db:seed --class=WorldFuelCatalogSeeder
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=topgrade_oilprice
# DB_USERNAME=root
# DB_PASSWORD=

# Production: redis for session/cache/queue. Local: database/file OK.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

# Production admin (used by seeder when APP_ENV=production)
# ADMIN_EMAIL=admin@yourdomain.com
# ADMIN_PASSWORD=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_QUEUE=default

# Named queues (Horizon-ready): notifications | sync | default
QUEUE_NOTIFICATIONS=notifications
QUEUE_SYNC=sync

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

TRACKMATE_BASE_URL=https://fuel.trackmate.page/api
PSO_PRICES_URL=https://psopk.com/en/fuels/fuel-prices

# Google Maps Platform — Places Nearby (server-side only; restrict key by IP)
GOOGLE_MAPS_API_KEY=

# Google Analytics 4 (public measurement ID, e.g. G-XXXXXXXX)
GOOGLE_ANALYTICS_ID=

# SEO (canonicals / sitemap / verification — never use localhost in production)
SEO_SITE_URL=https://oilprice.topgradesoftware.com
SEO_SITE_NAME="Fuel Prices PK"
SEO_GOOGLE_SITE_VERIFICATION=
SEO_BING_SITE_VERIFICATION=
# Set SEO_INDEXNOW_KEY when you enable the optional IndexNow integration.
SEO_GA_MEASUREMENT_ID="${GOOGLE_ANALYTICS_ID}"

# Google OAuth (PWA Sign in with Google — Web client ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Firebase (infra only — Auth / FCM). Prefer env secrets over JSON files.
FCM_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional local fallback path (never commit the file):
# FIREBASE_CREDENTIALS=

# Feature flags
FEATURE_GOOGLE_LOGIN=true
FEATURE_PUSH_NOTIFICATIONS=true
FEATURE_CRASHLYTICS=true
FEATURE_ANALYTICS=true
FEATURE_FAVORITES=true
FEATURE_GUIDES=true
FEATURE_AI_PREDICTION=false
FEATURE_NEARBY_STATIONS=true

# Content automation engine (publishing / growth pipeline)
CONTENT_AUTOMATION_ENABLED=true
CONTENT_PIPELINE_MODE=inline
CONTENT_AUTO_SUBMIT_REVIEW=true
CONTENT_AUTO_PUBLISH=false
# Daily price posts: templates only, $0, auto-publish (zero manual)
CONTENT_DAILY_AUTO_PUBLISH=true
CONTENT_DAILY_REVIEW_REQUIRED=false
# Weekly/monthly: AI when budget allows; review first
CONTENT_WEEKLY_REVIEW_REQUIRED=true
CONTENT_WEEKLY_AUTO_PUBLISH=false
CONTENT_MONTHLY_REVIEW_REQUIRED=true
CONTENT_MONTHLY_AUTO_PUBLISH=false
CONTENT_THRESHOLD_INCREASE=2.0
CONTENT_THRESHOLD_DECREASE=2.0
# AI budget manager — weekly/monthly/guides only; daily never spends
CONTENT_AI_PROVIDER=gemini
CONTENT_AI_MODEL=gemini-3.5-flash-lite
CONTENT_AI_FALLBACK=template
CONTENT_AI_MONTHLY_BUDGET_USD=10
CONTENT_AI_RESERVE_USD=2
CONTENT_AI_DAILY_LIMIT=3
CONTENT_AI_EST_COST_PER_REQUEST_USD=0.05
CONTENT_AI_MAX_COST_PER_REQUEST_USD=0.25
CONTENT_AI_PLENTY_USD=5
CONTENT_AI_HEALTHY_USD=5
CONTENT_AI_LOW_USD=3
CONTENT_AI_API_KEY=
# CONTENT_AI_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Alternate: CONTENT_AI_PROVIDER=openai_compatible + CONTENT_AI_MODEL=gpt-4o-mini
# CONTENT_AI_BASE_URL=https://api.openai.com/v1
CONTENT_DISTRIBUTE_INDEXNOW=true
CONTENT_DISTRIBUTE_WHATSAPP=false
CONTENT_DISTRIBUTE_TELEGRAM=false
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# WHATSAPP_WEBHOOK_URL=

APP_VERSION=0.2.3

VITE_APP_NAME="${APP_NAME}"

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Ops alerts (empty = disabled)
WATCHDOG_ALERT_EMAIL=

# One-off owner scripts (never commit real values)
OWNER_EMAIL=
OWNER_PW=

# Deploy scripts (backend/scripts) — required for any remote script
# DEPLOY_HOST=your.server.ip
# DEPLOY_SITE=/home/app/htdocs/example.com
# DEPLOY_APP_USER=app
# DEPLOY_REPO=/home/app/repo
# DEPLOY_SSH_KEY=~/.ssh/id_ed25519
# DEPLOY_SSH_PASSWORD=   # prefer key auth; never pass on CLI

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
